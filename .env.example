# Create a V2-only .env next to compose.yml. Never reuse the V1 data directory or secrets.
V2_DB_PASSWORD=
# Absolute path to an existing OpenRouter key file outside this repository.
V2_OPENROUTER_API_KEY_FILE=C:/path/to/openrouter-api-key
# Двусторонняя синхронизация с legacy V1. Значение ключа должно совпадать с V1 .env.
V1_PEER_URL=http://host.docker.internal:8080
V1_V2_SYNC_KEY=
# V2_EMBED_MODEL=embeddinggemma
