# Create a V2-only .env next to compose.yml. Never reuse the V1 data directory or secrets.
V2_DB_PASSWORD=
# Absolute path to an existing OpenRouter key file outside this repository.
V2_OPENROUTER_API_KEY_FILE=C:/Personal/Secrets/open-router-api-key-vs-code.txt
# Двусторонняя синхронизация с legacy V1. Значение ключа должно совпадать с V1 .env.
# V2_EMBED_MODEL=embeddinggemma
# V2_SEARCH_MIN_SEMANTIC_SIMILARITY=0.20
# V2_SEARCH_MIN_SEMANTIC_LEAD=0.04
# Semantic profiles: baseline (legacy), prompted (Google retrieval prompts), reranked (+ local Gemma).
# Switching baseline <-> prompted rebuilds derived embeddings; prompted <-> reranked shares vectors.
# V2_SEARCH_PROFILE=prompted
# V2_SEARCH_REQUIRE_SEMANTIC_LEAD=false
# V2_SEARCH_DIVERSIFY_SEMANTIC_SOURCES=true
# V2_SEARCH_MAX_SEMANTIC_RESULTS=5
# V2_SEARCH_RERANK_CANDIDATES=8
# V2_SEARCH_RERANK_MIN_SIMILARITY=0.20
# V2_SEARCH_RERANK_MIN_RELEVANCE=0.65
# V2_SEARCH_RERANK_TIMEOUT_SECONDS=45
